# Copy this file to config.yaml and fill in your API keys.
# config.yaml is gitignored — never commit it.

api_keys:
  openai: "sk-..."
  anthropic: "sk-ant-..."
  huggingface: "hf_..."
  mistral: "..."

models:
  - provider: openai
    model_id: gpt-4o
  - provider: anthropic
    model_id: claude-sonnet-4-6
  - provider: huggingface
    # Requires accepting the Meta license at huggingface.co/meta-llama/Llama-3.1-8B-Instruct
    model_id: meta-llama/Llama-3.1-8B-Instruct
  - provider: mistral
    model_id: open-mistral-7b
  - provider: huggingface
    model_id: Qwen/Qwen2.5-7B-Instruct

tasks:
  - gdpr
  - espr

# Optional: restrict to a subset of tasks without editing the tasks list above.
# Equivalent to passing --task on the CLI. Remove or leave empty to run all tasks.
# filter_tasks:
#   - espr

vagueness_levels:
  - low
  - medium
  - high
  - baseline

num_runs: 3

# Limit concurrent API calls to avoid rate limits.
max_concurrent: 5

# Retry settings for rate-limited requests (HTTP 429).
retry:
  max_retries: 3          # retries after the initial attempt
  base_delay_seconds: 60  # doubles each retry: 60s → 120s → 240s

# Enable dry_run to test your setup with a single condition.
dry_run:
  enabled: false
  model: openai/gpt-4o   # format: provider/model_id
  task: gdpr
  vagueness_level: low
  runs: 1

output_dir: outputs
