# Copy this file to config.yaml and fill in your API keys.
# config.yaml is gitignored — never commit it.

api_keys:
  openai: "sk-..."
  anthropic: "sk-ant-..."
  huggingface: "hf_..."
  mistral: "..."

models:
  - provider: openai
    model_id: gpt-4o
  - provider: anthropic
    model_id: claude-sonnet-4-6
  - provider: huggingface
    # Requires accepting the Meta license at huggingface.co/meta-llama/Llama-3.1-8B-Instruct
    model_id: meta-llama/Llama-3.1-8B-Instruct
    # Pinned: the default backend (novita) rejects the ESPR-high prompt; nscale
    # serves the full 128k context. Keep all Llama runs on one backend.
    hf_provider: nscale
    context_limit: 131072
  # Mistral API. open-mistral-7b is retired and silently redirected to
  # ministral-8b, so request the dated model explicitly.
  - provider: mistral
    model_id: ministral-8b-2512
  - provider: huggingface
    model_id: Qwen/Qwen2.5-7B-Instruct

tasks:
  - gdpr
  - espr

# Optional: restrict to a subset of tasks without editing the tasks list above.
# Equivalent to passing --task on the CLI. Remove or leave empty to run all tasks.
# filter_tasks:
#   - espr

vagueness_levels:
  - low
  - medium
  - high
  - baseline

# Runs per (model, task, vagueness_level) condition. Field-inclusion rates can
# only take N+1 distinct values, and CI width shrinks with sqrt(N); 20 gives 5%
# resolution. Raising this later only generates the missing run numbers.
num_runs: 20

# Generation settings passed to every model. Recorded in each raw output so
# batches collected at different times can be checked before being pooled.
generation:
  temperature: 0.7
  max_tokens: 32000

# Limit concurrent API calls to avoid rate limits.
max_concurrent: 5

# Retry settings for rate-limited requests (HTTP 429).
retry:
  max_retries: 3          # retries after the initial attempt
  base_delay_seconds: 60  # doubles each retry: 60s → 120s → 240s

# Enable dry_run to test your setup with a single condition.
dry_run:
  enabled: false
  model: openai/gpt-4o   # format: provider/model_id
  task: gdpr
  vagueness_level: low
  runs: 1

output_dir: outputs
